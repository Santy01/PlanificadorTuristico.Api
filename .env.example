# Copie este archivo como .env y complete las claves. El .env nunca se sube al repositorio.
# Solo están las variables que el código lee hoy; las que están vacías usan el valor por defecto de src/config.py.

# --- Modelo generativo: proveedor principal y de respaldo (groq, gemini o simulado)
# Con LLM_RESPALDO=gemini la API exige GEMINI_API_KEY al arrancar; sin esa clave, deje LLM_RESPALDO vacío.
LLM_PRINCIPAL=groq
LLM_RESPALDO=gemini
# Groq (principal): clave en https://console.groq.com/keys · modelo por defecto openai/gpt-oss-20b
GROQ_API_KEY=
GROQ_MODEL=
# Gemini (respaldo): clave en https://aistudio.google.com/apikey · el modelo se fija en GEMINI_MODEL
GEMINI_API_KEY=
GEMINI_MODEL=
# Límites de cada llamada (vacío = 30 s, 4096 tokens, 3 intentos, razonamiento low)
LLM_TIMEOUT_S=
LLM_MAX_TOKENS=
LLM_REINTENTOS=
LLM_RAZONAMIENTO=

# --- Clima: Open-Meteo, sin clave para uso no comercial
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_TIMEOUT_S=5

# --- RAG: Chroma local y embeddings locales, sin clave
VECTOR_DB_PATH=data/vectorstore
VECTOR_DB_COLECCION=atractivos
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_ACTIVO=true
RAG_TOP_K=12
# El margen sobre el mejor resultado decide CUÁNTOS se recuperan (con E5 las similitudes salen muy juntas)
RAG_MARGEN_SIMILITUD=0.05
# Pisos absolutos: si el mejor no los alcanza, «nada se parece» (calibración en docs/07-rag.md §9.1)
RAG_SIMILITUD_MINIMA=0.83
RAG_SIMILITUD_MINIMA_PREGUNTA=0.86
