# Proveedores del modelo: principal y respaldo (groq, gemini o simulado). Valores recomendados:
#   LLM_PRINCIPAL=groq   LLM_RESPALDO=gemini
LLM_PRINCIPAL=
LLM_RESPALDO=
# Groq: clave en https://console.groq.com/keys (modelo por defecto openai/gpt-oss-20b)
GROQ_API_KEY=
GROQ_MODEL=
# Gemini (respaldo): clave en https://aistudio.google.com/apikey (modelo por defecto gemini-2.5-flash)
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_TIMEOUT_S=
LLM_MAX_TOKENS=
LLM_REINTENTOS=
LLM_RAZONAMIENTO=
# Open-Meteo (https://open-meteo.com): no requiere clave para uso no comercial
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_TIMEOUT_S=5
# RAG: Chroma local persistente + embeddings locales (no requieren clave)
VECTOR_DB_PATH=data/vectorstore
VECTOR_DB_COLECCION=atractivos
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_ACTIVO=true
RAG_TOP_K=12
# Con E5 las similitudes salen muy juntas (0.80-0.93): el margen sobre el mejor decide CUÁNTOS se recuperan
RAG_MARGEN_SIMILITUD=0.05
# Pisos absolutos: si el mejor no los alcanza, «nada se parece» y no se recupera nada (calibración: docs/07-rag.md §9.1)
RAG_SIMILITUD_MINIMA=0.83
RAG_SIMILITUD_MINIMA_PREGUNTA=0.86
MAPS_API_KEY=
APP_ENV=development
LOG_LEVEL=INFO
